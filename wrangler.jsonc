{
  // Cloudflare Workers settings for Game N Huat (test site: test.gamenhuat.com).
  "name": "gamenhuat",
  "main": "src/index.js",
  "compatibility_date": "2026-11-24",

  // The page and pictures in "public". Requests to /api/... go to the game server in src/index.js.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/admin", "/admin/*"]
  },

  // Database. This is the TEST database; the live one is switched in at launch.
  "d1_databases": [
    { "binding": "DB", "database_name": "gamenhuat-db-test", "database_id": "c7eb714f-cd19-495d-b2bb-80baf3121d31" }
  ],

  // Pictures uploaded in the admin panel (sponsor banners, pop-ups, logos, prizes).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "gamenhuat-media" }
  ],

  // Email sending for sign-up and sign-in codes.
  "send_email": [{ "name": "EMAIL" }],

  // Rebuild the leaderboard every 5 minutes.
  "triggers": { "crons": ["*/5 * * * *"] },

  // Settings. TURNSTILE_SECRET is NOT here: it is added in the dashboard as a Secret.
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAAGP2hSKnavdhfwJL",
    "MAIL_FROM": "Game N Huat <noreply@test.gamenhuat.com>",
    "POT_DEFAULT": "1000000",
    "DAILY_TRIES": "10",
    "TRIAL_START": "2027-01-16",
    "SHOWDOWN_START": "2027-02-06",
    "EVENT_END": "2027-02-20",
    "ALLOW_EARLY": "1",   // test site: lets you play before 16 Jan. Remove on the live site.
    "GA_ID": "",          // Google Analytics Measurement ID, for example "G-ABC123XYZ". Empty = off.
    "ADMIN_EMAILS": "jk@epnox.com",   // who may use the admin panel (comma-separated)
    "ACCESS_TEAM": "epnox",
    "ACCESS_AUD": "8bb32c8d9ccc8b8bf238ddc9c687c60722ee685651f4133f211554659c7f1f5b"
  },

  "observability": { "enabled": true }
}
